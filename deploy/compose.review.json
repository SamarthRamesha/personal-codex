{
  "name": "personal-codex",
  "services": {
    "backend": {
      "image": "${PC_IMAGE:?review local image ID}",
      "pull_policy": "never",
      "user": "${PC_UID:?review non-root UID}:${PC_GID:?review non-root GID}",
      "network_mode": "host",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cpus": "1.0",
      "mem_limit": "512m",
      "memswap_limit": "512m",
      "pids_limit": 128,
      "init": false,
      "restart": "unless-stopped",
      "stop_grace_period": "15s",
      "working_dir": "/opt/personal-codex",
      "environment": {
        "PERSONAL_CODEX_HOST": "127.0.0.1",
        "PERSONAL_CODEX_PORT": "8787",
        "PERSONAL_CODEX_DATA": "/var/lib/personal-codex",
        "PERSONAL_CODEX_TOKEN_FILE": "/run/secrets/owner-token",
        "PERSONAL_CODEX_WORKER_TOKEN_FILE": "/run/secrets/worker-token",
        "PERSONAL_CODEX_PUBLIC_ORIGIN": "${PC_ORIGIN:?review HTTPS origin}",
        "PERSONAL_CODEX_PROJECT_ROOTS": "/var/lib/personal-codex/projects",
        "PERSONAL_CODEX_EXECUTION_MODE": "disabled",
        "PERSONAL_CODEX_RESERVE_GB": "200",
        "PERSONAL_CODEX_STORAGE_GB": "74",
        "PERSONAL_CODEX_ENABLE_GATEWAY": "0"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${PC_ROOT:?review dedicated root}/data",
          "target": "/var/lib/personal-codex",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${PC_ROOT:?review dedicated root}/secrets/owner-token",
          "target": "/run/secrets/owner-token",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${PC_ROOT:?review dedicated root}/secrets/worker-token",
          "target": "/run/secrets/worker-token",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python3",
          "-c",
          "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8787/api/health',timeout=3); assert r.status==200"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "15s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "3"
        }
      },
      "ulimits": {
        "nofile": {
          "soft": 256,
          "hard": 256
        }
      },
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=16777216,mode=1777"
      ]
    }
  }
}
